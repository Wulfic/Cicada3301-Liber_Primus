# Text is stored and checked out with LF on every platform (stops the CRLF warnings on Windows).
* text=auto eol=lf

# Binary: never touch line endings, never diff as text.
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.pdf  binary
*.docx binary
*.bin  binary
*.gz   binary

# Binary despite the .txt name (outguess payloads with NUL/CR bytes).
data/outguess/*_hint.txt binary
